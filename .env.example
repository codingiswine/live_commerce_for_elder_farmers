# ============================================
# 농담 프로젝트 환경 변수 예시
# ============================================
#
# 사용 방법:
# 1. 이 파일을 복사하여 .env 파일을 생성하세요
#    cp .env.example .env
#
# 2. 아래 값들을 실제 값으로 변경하세요
#

# OpenAI API Key (필수)
# https://platform.openai.com/api-keys 에서 발급받을 수 있습니다
OPENAI_API_KEY=your_openai_api_key_here
